# 外部 LLM API キー (どれか 1 つでも可)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxx
GOOGLE_API_KEY=xxxxxxxxxxxx

# ゲートウェイ認証トークン (任意の文字列に変更すること)
GATEWAY_API_KEY=change-me-to-a-secure-random-string

# PostgreSQL パスワード
POSTGRES_PASSWORD=gateway

# Grafana 管理パスワード
GRAFANA_PASSWORD=admin

# セマンティックキャッシュ（任意。未設定なら app/config.yaml の cache: の値）
# GATEWAY_CACHE_ENABLED=true      # false でキャッシュを使わない
# GATEWAY_CACHE_LOCAL_ONLY=true   # false で外部の LLM の答えもキャッシュする（app と tenant が一致する範囲だけ）
