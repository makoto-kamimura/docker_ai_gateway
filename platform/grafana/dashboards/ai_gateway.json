{
  "title": "AI Gateway",
  "uid": "ai-gateway",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (source別)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(gateway_requests_total[1m])",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Cache Hit Rate",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "gateway_cache_hit_ratio",
          "legendFormat": "Hit Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 0.3},
              {"color": "green", "value": 0.7}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Response Latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(gateway_request_duration_seconds_bucket[5m]))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, rate(gateway_request_duration_seconds_bucket[5m]))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, rate(gateway_request_duration_seconds_bucket[5m]))", "legendFormat": "p99"}
      ]
    },
    {
      "id": 4,
      "title": "Knowledge Store 蓄積件数",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
      "targets": [
        {"expr": "gateway_knowledge_entries_total", "legendFormat": "Total"}
      ]
    },
    {
      "id": 5,
      "title": "外部 LLM 消費トークン数",
      "type": "timeseries",
      "gridPos": {"h": 4, "w": 12, "x": 6, "y": 8},
      "targets": [
        {"expr": "rate(gateway_external_tokens_total[5m])", "legendFormat": "tokens/s"}
      ]
    }
  ]
}
